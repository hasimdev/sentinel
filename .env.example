# Copy to .env and fill in locally. Never commit .env.

# Common tags (every log, metric and deploy carries these)
SERVICE=shoplite
ENV=local
VERSION=0.0.0
COMMIT_SHA=

# ShopLite: share of checkouts that fail on purpose (0 to 1)
SHOPLITE_FAIL_RATE=0
# Optional: also write JSON logs here (make run-shoplite sets logs/shoplite.log)
SHOPLITE_LOG_FILE=

# AI
ANTHROPIC_API_KEY=

# Observability
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and stalls.
GRAFANA_URL=http://127.0.0.1:3000
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100

# Orchestrator (optional overrides)
ORCHESTRATOR_DB_PATH=
ORCHESTRATOR_LOG_FILE=

# Harness (DeployControl)
HARNESS_ACCOUNT_ID=
HARNESS_API_KEY=

# ServiceNow (Ticketing / ChangeMgmt)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack (Chat)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Grafana (local monitoring stack): admin password, choose your own
GRAFANA_ADMIN_PASSWORD=
