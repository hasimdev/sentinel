# Copy to .env and fill in locally. Never commit .env.

# Common tags (every log, metric and deploy carries these)
SERVICE=shoplite
ENV=local
VERSION=0.0.0
COMMIT_SHA=

# ShopLite: share of checkouts that fail on purpose (0 to 1)
SHOPLITE_FAIL_RATE=0
# Optional: also write JSON logs here (make run-shoplite sets logs/shoplite.log)
SHOPLITE_LOG_FILE=

# AI (triage agent). Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Optional: TRIAGE_ENABLED=false turns AI triage off; defaults below
TRIAGE_ENABLED=
TRIAGE_MODEL=
TRIAGE_EFFORT=

# Observability
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and stalls.
GRAFANA_URL=http://127.0.0.1:3000
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100

# Orchestrator (optional overrides)
ORCHESTRATOR_DB_PATH=
ORCHESTRATOR_LOG_FILE=

# Harness (DeployControl)
HARNESS_ACCOUNT_ID=
HARNESS_API_KEY=

# ServiceNow (ChangeMgmt): incident records, emergency changes, CAB approvals.
# The integration user needs the itil and approval_admin roles (see orchestrator/README.md).
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Group a change is assigned to before CAB review (default: Change Management)
SERVICENOW_CHANGE_GROUP=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Slack (Chat): see infra/slack/manifest.yaml. Paste tokens in .env only, never in chat or git.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=

# Grafana (local monitoring stack): admin password, choose your own
GRAFANA_ADMIN_PASSWORD=
